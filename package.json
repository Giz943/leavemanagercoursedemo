{
  "name": "leave-manager",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web \"npm run dev -w @leave/api\" \"npm run dev -w @leave/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p packages/shared && tsc -p apps/api && tsc -p apps/web && tsc -p tooling",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
